# ══════════════════════════════════════════
#  UZUM MARKET — Muhit o'zgaruvchilari
#  .env.example faylini .env ga nusxalang
#  va qiymatlarni to'ldiring
# ══════════════════════════════════════════

# Telegram Bot Token (@BotFather dan olinadi)
BOT_TOKEN=your_bot_token_here

# Telegram Admin ID (sizning Telegram ID ingiz)
ADMIN_ID=your_telegram_id_here

# Mini App URL (hosting domeni)
WEB_APP_URL=https://your-domain.com

# Do'kon nomi
SHOP_NAME=UZUM MARKET

# Support username
SUPPORT=@your_support_username

# Admin panel paroli (murakkab qiling!)
ADMIN_PASSWORD=your_strong_password_here

# Flask secret key (tasodifiy uzun satr)
SECRET_KEY=your_very_long_random_secret_key_here

# SQLite fayl nomi
DB_NAME=uzum_market.db
